---
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import Heading from '../ui/Heading.astro';

import styxx from '../../assets/mascotas/styxx-mision.png';
import relic from '../../assets/economia/agora-relic.png';
import cofre from '../../assets/cofres/cofre-plata.png';
import emblema from '../../assets/emblemas/emblema-plata.png';
import marco from '../../assets/marcos/marco-segador.png';

const misiones = [
  { t: 'Juega un torneo', xp: 250, p: 100, c: '#3B8DFF' },
  { t: 'Gana 3 batallas', xp: 120, p: 66, c: '#FF4D5E' },
  { t: 'Reta a un amigo', xp: 90, p: 0, c: '#0AFF7A' },
];

const recompensas = [
  { img: relic, t: 'Agora Relics' },
  { img: cofre, t: 'Cofres' },
  { img: emblema, t: 'Emblemas' },
  { img: marco, t: 'Marcos' },
];
---

<section id="progresion" class="u-shell scroll-mt-24 py-[var(--spacing-section)]">
  <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
    <div class="relative order-2 lg:order-1">
      <!-- Tablón de misiones al estilo de la app -->
      <div class="relative mx-auto mt-28 max-w-[480px] sm:mt-32 lg:mx-0 lg:mt-0">
        <Image
          src={styxx}
          alt="Styxx, mascota de Ágora, señalando las misiones diarias"
          width={420}
          densities={[1, 2]}
          class="u-mascot absolute -left-6 -top-28 z-0 w-[170px] sm:-left-16 sm:-top-32 sm:w-[210px]"
          data-pop
        />

        <div class="u-panel relative z-10 ml-auto max-w-[400px] p-4 sm:p-5" style="--edge: rgb(59 141 255 / 0.55)" data-reveal>
          <div class="flex items-center justify-between">
            <p class="flex items-center gap-2 font-display text-[0.74rem] font-bold uppercase tracking-wide">
              <Icon name="check" class="h-4 w-4 text-neon" />
              Misiones diarias
            </p>
            <p class="font-mono text-[0.62rem] text-muted">22h 16m</p>
          </div>
          <ul class="mt-4 space-y-2" data-missions>
            {
              misiones.map((m) => (
                <li class="relative overflow-hidden rounded-xl border border-line bg-surface/70 py-3 pl-4 pr-3">
                  <span class="absolute inset-y-0 left-0 w-[3px]" style={`background:${m.c}`} aria-hidden="true" />
                  <div class="flex items-center justify-between gap-3">
                    <div class="min-w-0 flex-1">
                      <p class="text-[0.84rem]">{m.t}</p>
                      <div class="mt-2 h-1 overflow-hidden rounded-full bg-line">
                        <div
                          class="mission-bar h-full rounded-full"
                          style={`--w:${m.p}%;background:${m.c}`}
                        />
                      </div>
                    </div>
                    <span class="flex shrink-0 items-center gap-1 rounded-full border border-neon/35 bg-neon/10 px-2.5 py-1 font-mono text-[0.7rem] text-neon">
                      <Icon name="bolt" class="h-3 w-3" />+{m.xp}
                    </span>
                  </div>
                </li>
              ))
            }
          </ul>

          <div class="mt-4 rounded-xl border border-line bg-ink/60 p-3">
            <div class="flex items-center justify-between font-mono text-[0.62rem] uppercase tracking-[0.14em]">
              <span class="text-neon">Nivel 24</span>
              <span class="text-muted">2.380 / 3.000 XP</span>
            </div>
            <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-line">
              <div class="mission-bar h-full rounded-full bg-[linear-gradient(90deg,#0AFF7A,#47F59A)]" style="--w: 79%"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="order-1 lg:order-2">
      <Heading
        tag="Progresión"
        tone="var(--color-styxx)"
        title='Cada partida <span style="color:var(--color-styxx)">te hace subir</span>'
        intro="Cumple misiones diarias, gana experiencia y sube de nivel. Por el camino desbloqueas cofres, Agora Relics, títulos, emblemas y marcos para un perfil único. El resto lo descubrirás dentro."
      />

      <ul class="mt-8 flex flex-wrap gap-3" data-reveal-group>
        {
          recompensas.map((r) => (
            <li class="flex items-center gap-2.5 rounded-full border border-line bg-surface/50 py-1.5 pl-1.5 pr-4" data-reveal-item>
              <Image src={r.img} alt="" width={64} densities={[1, 2]} class="h-8 w-8 object-contain" />
              <span class="text-[0.8rem]">{r.t}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 flex items-center gap-2 text-[0.82rem] text-muted" data-reveal>
        <Icon name="shield" class="h-4 w-4 text-neon" />
        Nada de esto da ventaja en partida: es tu progreso y tu estilo.
      </p>
    </div>
  </div>
</section>

<style>
  .mission-bar {
    width: 0;
    transition: width 1.4s var(--ease-out-expo) 0.3s;
  }
  :global(.is-visible) .mission-bar,
  :global(html:not(.js)) .mission-bar,
  :global(.sin-motion) .mission-bar {
    width: var(--w);
  }
</style>

<script>
  // Las barras se llenan al entrar en pantalla
  const box = document.querySelector('#progresion');
  if (box) {
    const io = new IntersectionObserver(
      ([e]) => {
        if (e?.isIntersecting) {
          box.classList.add('is-visible');
          io.disconnect();
        }
      },
      { threshold: 0.3 },
    );
    io.observe(box);
  }
</script>
