---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  intro?: string;
  class?: string;
  align?: 'left' | 'center';
}
const { id, eyebrow, title, intro, class: className = '', align = 'left' } = Astro.props;
---

<section id={id} class={`u-shell scroll-mt-24 py-[var(--spacing-section)] ${className}`}>
  {
    (eyebrow || title || intro) && (
      <header class={align === 'center' ? 'mx-auto max-w-2xl text-center' : 'max-w-2xl'} data-reveal>
        {eyebrow && <p class="u-eyebrow">{eyebrow}</p>}
        {title && <h2 class="mt-3 text-display sm:mt-4">{title}</h2>}
        {intro && <p class="mt-4 text-[0.94rem] leading-relaxed text-muted sm:mt-5 sm:text-[1.05rem]">{intro}</p>}
        <div class={`u-rule mt-6 sm:mt-8 ${align === 'center' ? 'mx-auto w-24' : 'w-32'}`} />
      </header>
    )
  }
  <slot />
</section>
