---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/ui/Icon.astro';
import Heading from '../components/ui/Heading.astro';
import { breadcrumbSchema } from '../lib/schema.js';
import { url } from '../lib/url.js';
import { CONTACT } from '../data/site.js';
import gorgo from '../assets/mascotas/gorgo-senala.png';

// Formulario alojado en Formspree: la web es estática y no puede recibir envíos.
const ENDPOINT = 'https://formspree.io/f/xrpzaoro';

// Programa de creadores: de momento se habla por correo, caso a caso.
const asunto = 'Programa de creadores de Ágora';
const cuerpo = [
  'Hola, equipo de Ágora:',
  '',
  'Quiero traer a mi comunidad a Ágora.',
  '',
  'Nombre o alias:',
  'Enlaces a mi comunidad (Twitch, YouTube, TikTok, Discord…):',
  'Tamaño aproximado de la comunidad:',
  'Juegos a los que jugamos:',
  '¿Ya tenéis clan en Ágora? (nombre):',
  '',
  'Gracias.',
].join('\n');
const mailCreadores = `mailto:${CONTACT.email}?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(cuerpo)}`;

const campos = [
  { id: 'clan', name: 'Clan en Ágora', ph: 'Demon Angels', required: false, hint: 'opcional' },
  { id: 'usuario', name: 'Usuario en Ágora', ph: '@tuusuario', required: false, hint: 'opcional' },
  { id: 'real', name: 'Nombre real', ph: 'Cómo te llamamos', required: true, hint: '' },
  {
    id: 'comunidad',
    name: 'Comunidad o enlace a tus redes',
    ph: 'Discord, Twitch, Instagram, TikTok…',
    required: true,
    hint: '',
  },
];

const ventajas = [
  {
    icon: 'users',
    t: 'Más de 25 plazas',
    d: 'Un clan normal tiene 25 plazas. Si tu comunidad es grande, la ampliamos gratis para que entre entera.',
  },
  {
    icon: 'bracket',
    t: 'Torneos con tu nombre',
    d: 'Creas torneos para los tuyos desde el móvil, con tus reglas, y los compartes con un enlace.',
  },
  {
    icon: 'shield',
    t: 'Te echamos una mano',
    d: 'Te acompañamos en el primer torneo: formato, calendario y arbitraje.',
  },
];

const numeros = [
  { id: 'huecos', name: '¿Cuántas plazas necesitáis?', ph: '100', min: 1, max: 5000 },
  { id: 'admins', name: '¿Cuántos administran el grupo?', ph: '3', min: 1, max: 200 },
];
---

<Base
  title="Trae tu comunidad a Ágora: clanes grandes y creadores"
  description="Amplía tu clan de Ágora por encima de 25 plazas o únete al programa de creadores: si traes a tu comunidad durante el lanzamiento, te pagamos por cada jugador."
  schema={[
    breadcrumbSchema([
      { label: 'Inicio', href: '/' },
      { label: 'Comunidades', href: '/comunidad' },
    ]),
  ]}
>
  <section class="u-shell relative pb-[var(--spacing-section)] pt-12 sm:pt-16">
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-[420px] bg-[radial-gradient(ellipse_60%_100%_at_50%_0%,rgb(143_209_79/0.1),transparent)]"
      aria-hidden="true"
    >
    </div>

    <Heading
      as="h1"
      class="relative"
      tag="Para creadores, clanes y servidores"
      tone="var(--color-gorgo)"
      title='Trae tu comunidad <span style="color:var(--color-gorgo)">a Ágora</span>'
      intro="Hay dos caminos, según de dónde vengas. Elige el tuyo."
    />

    <!-- Los dos caminos -->
    <div class="relative mt-10 grid gap-4 md:grid-cols-2" data-reveal-group>
      <a
        href="#ampliar"
        class="u-panel group block p-6 transition-transform duration-500 hover:-translate-y-1 sm:p-7"
        style="--edge: rgb(143 209 79 / 0.55)"
        title="Pedir la ampliación de tu clan en Ágora"
        data-reveal-item
      >
        <span class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-gorgo">Ya tengo clan en Ágora</span>
        <h2 class="mt-3 font-display text-[1.3rem] font-black uppercase leading-tight">Amplía tu clan</h2>
        <p class="mt-2 max-w-sm text-[0.9rem] leading-relaxed text-muted">
          Los clanes tienen 25 plazas. Si tu comunidad es más grande, pídenos más y te lo ampliamos
          gratis.
        </p>
        <span class="mt-5 inline-flex items-center gap-2 font-display text-[0.72rem] font-bold uppercase tracking-wide text-gorgo">
          Rellenar solicitud
          <Icon name="arrow" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
        </span>
      </a>

      <div
        id="creadores"
        class="u-panel scroll-mt-28 p-6 sm:p-7"
        style="--edge: rgb(245 196 81 / 0.6)"
        data-reveal-item
      >
        <span class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-gold">Vengo de fuera con mi comunidad</span>
        <h2 class="mt-3 font-display text-[1.3rem] font-black uppercase leading-tight">
          Programa de <span class="t-gold">creadores</span>
        </h2>
        <p class="mt-2 max-w-sm text-[0.9rem] leading-relaxed text-muted">
          Streamers y creadores que traigan a su comunidad durante el lanzamiento: te pagamos por cada
          jugador que entre. Lo hablamos por correo, caso a caso.
        </p>
        <a href={mailCreadores} class="u-btn u-btn--gold mt-5" title="Escribir a Ágora sobre el programa de creadores">
          <Icon name="coin" class="h-4 w-4" />
          Escríbenos
        </a>
        <p class="mt-3 font-mono text-[0.62rem] text-muted">{CONTACT.email}</p>
      </div>
    </div>

    <div class="relative mt-20 grid gap-14 lg:grid-cols-[1fr_1fr] lg:gap-16">
    <!-- Qué te llevas -->
    <div>
      <h2 class="font-display text-[1.1rem] font-black uppercase" data-reveal>Lo que te llevas</h2>
      <ul class="mt-6 space-y-3" data-reveal-group>
        {
          ventajas.map((v) => (
            <li class="flex gap-4 rounded-2xl border border-line bg-ink/50 p-4 sm:p-5" data-reveal-item>
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-gorgo/12 text-gorgo">
                <Icon name={v.icon} class="h-5 w-5" />
              </span>
              <span>
                <span class="block font-display text-[0.86rem] font-bold uppercase tracking-wide">{v.t}</span>
                <span class="mt-1 block text-[0.88rem] leading-relaxed text-muted">{v.d}</span>
              </span>
            </li>
          ))
        }
      </ul>

      <p
        class="u-chip mt-8 w-max max-w-full !border-gorgo/40 font-mono text-[0.58rem] uppercase tracking-[0.16em] text-gorgo"
        data-reveal
      >
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-gorgo opacity-70"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-gorgo"></span>
        </span>
        Programa de lanzamiento · plazas limitadas
      </p>
    </div>

    <!-- Gorgo asoma por encima de la tarjeta y señala el formulario -->
    <div id="ampliar" class="relative mx-auto mt-16 w-full max-w-xl scroll-mt-40 self-start lg:sticky lg:top-28 lg:mt-0">
      <Image
        src={gorgo}
        alt="Gorgo, mascota de Ágora, señalando el formulario"
        width={420}
        densities={[1, 2]}
        class="u-mascot absolute -top-[92px] right-2 z-10 w-[110px] -scale-x-100 sm:-top-[118px] sm:right-6 sm:w-[140px]"
        data-float="7"
      />

      <form
        class="u-card relative !bg-surface/85 p-5 sm:p-7"
        action={ENDPOINT}
        method="POST"
        data-comunidad-form
        novalidate
      >
        <!-- Asunto del correo y trampa antispam -->
        <input type="hidden" name="_subject" value="Solicitud de ampliación de clan en Ágora" />
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

        <h2 class="font-display text-[1rem] font-black uppercase tracking-wide">Amplía tu clan</h2>
        <p class="mt-1.5 text-[0.82rem] text-muted">Dos minutos. Te respondemos por correo.</p>

        <div class="mt-6 grid gap-3.5 sm:grid-cols-2">
          {
            campos.map((c) => (
              <label class="block" class:list={[c.id === 'comunidad' && 'sm:col-span-2']}>
                <span class="mb-1.5 block font-mono text-[0.6rem] uppercase tracking-[0.16em] text-muted sm:text-[0.64rem]">
                  {c.name}
                  {c.hint && <span class="normal-case tracking-normal"> ({c.hint})</span>}
                </span>
                <input
                  class="u-input"
                  type="text"
                  id={`cm-${c.id}`}
                  name={c.name}
                  placeholder={c.ph}
                  required={c.required}
                  autocomplete="off"
                />
              </label>
            ))
          }
          <label class="block sm:col-span-2">
            <span class="mb-1.5 block font-mono text-[0.6rem] uppercase tracking-[0.16em] text-muted sm:text-[0.64rem]">
              Correo de contacto
            </span>
            <input
              class="u-input"
              type="email"
              id="cm-email"
              name="email"
              placeholder="donde te respondemos"
              required
              autocomplete="email"
            />
          </label>

          {
            numeros.map((n) => (
              <label class="block">
                <span class="mb-1.5 block font-mono text-[0.6rem] uppercase tracking-[0.16em] text-muted sm:text-[0.64rem]">
                  {n.name}
                </span>
                <input
                  class="u-input"
                  type="number"
                  inputmode="numeric"
                  id={`cm-${n.id}`}
                  name={n.name}
                  placeholder={n.ph}
                  min={n.min}
                  max={n.max}
                  required
                />
              </label>
            ))
          }

          <label class="block sm:col-span-2">
            <span class="mb-1.5 block font-mono text-[0.6rem] uppercase tracking-[0.16em] text-muted sm:text-[0.64rem]">
              Algo más que contarnos <span class="normal-case tracking-normal">(opcional)</span>
            </span>
            <textarea
              class="u-input min-h-[104px] resize-y"
              id="cm-mensaje"
              name="Mensaje"
              placeholder="Qué juegos jugáis, qué torneo tenéis en mente…"></textarea>
          </label>
        </div>

        <p class="mt-3 hidden text-[0.78rem] text-danger" data-comunidad-error role="alert"></p>

        <button type="submit" class="u-btn u-btn--primary mt-5 w-full" data-comunidad-submit>
          <span data-comunidad-texto>Enviar solicitud</span>
          <Icon name="arrow" class="hidden h-4 w-4 sm:block" />
        </button>

        <p class="mt-3 text-center text-[0.72rem] leading-relaxed text-muted">
          Te contestamos al correo que nos dejes. Nada de spam, solo lo de tu comunidad.
        </p>
      </form>

      <!-- Confirmación -->
      <div class="u-card hidden p-6 text-center sm:p-8" data-comunidad-ok>
        <div class="mx-auto grid h-12 w-12 place-items-center rounded-full border border-neon/40 bg-neon/10">
          <Icon name="check" class="h-5 w-5 text-neon" />
        </div>
        <h2 class="mt-4 font-display text-[1.05rem] font-black uppercase tracking-wide">
          Solicitud enviada
        </h2>
        <p class="mx-auto mt-3 max-w-md text-[0.88rem] text-muted">
          Lo revisamos y te escribimos para ampliar tu clan. Mientras tanto, consulta cómo entrar
          en Ágora.
        </p>
        <a
          href={url('/descargar')}
          title="Cómo entrar en Ágora"
          class="u-btn u-btn--ghost mt-6">Ver opciones de acceso</a
        >
      </div>
    </div>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-comunidad-form]');
  if (form) {
    const boton = form.querySelector<HTMLButtonElement>('[data-comunidad-submit]');
    const texto = form.querySelector<HTMLElement>('[data-comunidad-texto]');
    const aviso = form.querySelector<HTMLElement>('[data-comunidad-error]');
    const exito = document.querySelector<HTMLElement>('[data-comunidad-ok]');

    const error = (msg: string) => {
      if (!aviso) return;
      aviso.textContent = msg;
      aviso.classList.remove('hidden');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      aviso?.classList.add('hidden');

      // Validación del navegador, con foco en el primer campo que falle
      const invalido = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea')].find(
        (c) => !c.checkValidity(),
      );
      if (invalido) {
        invalido.setAttribute('aria-invalid', 'true');
        invalido.focus();
        error('Revisa los campos marcados: falta algo por rellenar.');
        return;
      }
      form.querySelectorAll('[aria-invalid]').forEach((c) => c.removeAttribute('aria-invalid'));

      if (boton) boton.disabled = true;
      if (texto) texto.textContent = 'Enviando…';

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
          signal: AbortSignal.timeout ? AbortSignal.timeout(15000) : undefined,
        });
        if (res.ok) {
          form.classList.add('hidden');
          exito?.classList.remove('hidden');
          exito?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }
        const datos = await res.json().catch(() => ({}));
        error(datos?.errors?.[0]?.message || 'No hemos podido enviarlo. Inténtalo en un momento.');
      } catch (err) {
        console.error('[comunidad] envío fallido', err);
        error('No hemos podido conectar. Escríbenos a support@agoraclan.com y lo vemos.');
      } finally {
        if (boton) boton.disabled = false;
        if (texto) texto.textContent = 'Enviar solicitud';
      }
    });
  }
</script>
