---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Heading from '../components/ui/Heading.astro';
import PhoneMockup from '../components/ui/PhoneMockup.astro';
import Tilt from '../components/ui/Tilt.astro';
import StoreButtons from '../components/ui/StoreButtons.astro';
import Preregistro from '../components/sections/Preregistro.astro';
import Icon from '../components/ui/Icon.astro';
import BrandMark from '../components/ui/BrandMark.astro';
import { SOCIAL } from '../data/site.js';
import { appSchema, breadcrumbSchema, faqSchema } from '../lib/schema.js';

import bienvenida from '../assets/app/agora-app-bienvenida.png';
import styxxEstandarte from '../assets/mascotas/styxx-estandarte.png';

const pasos = [
  { t: 'Descarga la app', d: 'Desde App Store o Google Play, cuando esté publicada.' },
  { t: 'Crea tu cuenta', d: 'Usuario, correo y fecha de nacimiento. En un minuto estás dentro.' },
  { t: 'Añade tus juegos', d: 'Pon el ID de cada juego en tu perfil. Si el juego tiene API oficial, tus datos se verifican solos.' },
  { t: 'Empieza a competir', d: 'Únete a un clan, reta a tus amigos o apúntate a tu primer torneo.' },
];

const faqs = [
  {
    q: '¿Cuándo estará disponible Ágora?',
    a: 'Ágora llegará a App Store (iOS) y Google Play (Android), con foco inicial en España. En esta página verás el estado de cada tienda y, cuando la app esté publicada, su enlace de descarga.',
  },
  {
    q: '¿Cuánto cuesta?',
    a: 'Descargar Ágora y competir es gratis. Hay cosméticos opcionales y una suscripción, Ágora Rise, que no dan ninguna ventaja en partida.',
  },
  {
    q: '¿Puedo jugar desde el ordenador?',
    a: 'La app es para móvil, pero puedes competir en juegos de PC como Valorant o League of Legends: la partida se juega en el ordenador y se organiza y se reporta desde la app.',
  },
];
---

<Base
  title="Descargar Ágora para iOS y Android"
  description="Ágora llega a App Store y Google Play. Consulta el estado de la descarga y del pre-registro, y cómo empezar a competir en torneos desde el móvil."
  schema={[
    appSchema(),
    breadcrumbSchema([
      { label: 'Inicio', href: '/' },
      { label: 'Descargar', href: '/descargar' },
    ]),
    faqSchema(faqs),
  ]}
>
  <section class="u-shell grid gap-14 pt-12 sm:pt-16 lg:grid-cols-[1.1fr_1fr] lg:items-center lg:pt-20">
    <div>
      <Heading as="h1" tag="iOS y Android" title='Descarga <span class="t-neon">Ágora</span>' />

      <!-- El texto se resuelve en runtime con /api/v1/config. -->
      <p class="u-lead mt-5 max-w-lg" data-reveal data-phase="live" hidden>
        Ágora ya está en App Store y Google Play. Descárgala gratis y entra a competir.
      </p>
      <p class="u-lead mt-5 max-w-lg" data-reveal data-phase="preregister" hidden>
        La app todavía no está en las tiendas, pero el pre-registro está abierto: reserva tu nombre
        de usuario y llévate las recompensas de fundador el día que abramos.
      </p>
      <p class="u-lead mt-5 max-w-lg" data-reveal data-phase="upcoming" hidden>
        El pre-registro de fundadores ha cerrado. La app llegará a App Store y Google Play y aquí
        tendrás el enlace de cada tienda en cuanto esté publicada.
      </p>
      <p class="u-lead mt-5 max-w-lg" data-reveal data-phase="unknown" data-phase-status>
        Comprobando el estado del pre-registro y de las tiendas…
      </p>

      <StoreButtons class="mt-8" />

      <a
        href="#pre-registro"
        data-phase="preregister"
        hidden
        title="Reserva tu plaza en el pre-registro de Ágora"
        class="u-btn u-btn--primary mt-5"
      >
        Reservar mi plaza
        <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>

    <div class="relative mx-auto w-full max-w-[420px]" data-reveal data-reveal-delay="0.08">
      <Tilt class="w-full" rotate={9}>
        <div class="relative pb-4">
          <PhoneMockup
            src={bienvenida}
            alt="Pantalla de bienvenida de Ágora en el móvil"
            width={340}
            class="w-[68%]"
            offset={2}
            priority
          />
          <Image
            src={styxxEstandarte}
            alt="Styxx, la mascota de Ágora, sosteniendo el estandarte"
            width={440}
            densities={[1, 2]}
            class="u-mascot absolute bottom-0 right-0 z-10 w-[44%] max-w-[190px]"
            data-float="8"
            data-atropos-offset="-6"
          />
        </div>
      </Tilt>
    </div>
  </section>

  <!-- Solo se muestra con el pre-registro abierto -->
  <Preregistro id="pre-registro" compact onlyPreregister />

  <!-- PASOS -->
  <section class="u-shell py-[var(--spacing-section)]">
    <Heading tag="Primeros pasos" title="De la descarga a tu primer torneo" />
    <ol class="mt-10 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
      {
        pasos.map((p, i) => (
          <li class="bg-ink p-5 sm:p-6" data-reveal-item>
            <p class="font-mono text-[0.62rem] text-neon">0{i + 1}</p>
            <h3 class="mt-3 font-display text-[0.85rem] font-bold uppercase tracking-wide">{p.t}</h3>
            <p class="mt-2 text-[0.86rem] leading-relaxed text-muted">{p.d}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-10 flex flex-col items-center gap-6 rounded-2xl border border-line bg-surface/30 p-6 sm:flex-row sm:p-7" data-reveal>
      <div class="flex-1 text-center sm:text-left">
        <h3 class="font-display text-[0.95rem] font-black uppercase tracking-wide">Sigue el lanzamiento</h3>
        <p class="mt-2 text-sm text-muted">Fechas, torneos oficiales y novedades, primero en nuestras redes.</p>
      </div>
      <ul class="flex gap-2.5">
        {
          SOCIAL.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener" title={s.title} class="u-btn u-btn--ghost !px-4 !py-2.5 !text-[0.66rem]">
                <BrandMark mark={s.name.toLowerCase()} class="h-3.5 w-3.5" />
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-16 max-w-3xl divide-y divide-line border-y border-line" data-reveal>
      {
        faqs.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden">
              <h3 class="font-body text-[0.98rem] font-semibold tracking-normal transition-colors group-open:text-neon">{f.q}</h3>
              <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full border border-line text-muted transition-all duration-300 group-open:rotate-45 group-open:border-neon group-open:text-neon">
                <Icon name="plus" class="h-3.5 w-3.5" />
              </span>
            </summary>
            <p class="max-w-2xl pb-6 text-[0.92rem] leading-relaxed text-muted">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</Base>
