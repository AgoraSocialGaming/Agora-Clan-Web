---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Section from '../components/ui/Section.astro';
import PhoneMockup from '../components/ui/PhoneMockup.astro';
import Tilt from '../components/ui/Tilt.astro';
import Preregistro from '../components/sections/Preregistro.astro';
import Icon from '../components/ui/Icon.astro';
import BrandMark from '../components/ui/BrandMark.astro';
import { APP, SOCIAL } from '../data/site.js';
import { appSchema, breadcrumbSchema, faqSchema } from '../lib/schema.js';

import bienvenida from '../assets/app/agora-app-bienvenida.png';
import styxxEstandarte from '../assets/mascotas/styxx-estandarte.png';

const pasos = [
  { n: '01', t: 'Reserva tu plaza', d: 'Nombre de usuario, correo y edad. Diez segundos y listo.' },
  { n: '02', t: 'Confirma el correo', d: 'Te llega un enlace para activar la reserva.' },
  { n: '03', t: 'Descarga el día del lanzamiento', d: 'Te avisamos en cuanto esté en las tiendas.' },
  { n: '04', t: 'Reclama el Pack Fundador', d: 'Entras con el marco Pionero y 7 días de Rise, con su insignia y su marco.' },
];

const faqs = [
  {
    q: '¿Cuándo estará disponible Ágora?',
    a: 'Ágora llega próximamente a App Store y Google Play, con lanzamiento simultáneo en España. Reservando tu plaza en el pre-registro te avisamos el mismo día.',
  },
  {
    q: '¿Cuánto cuesta?',
    a: 'Descargar y competir es libre. Hay cosméticos opcionales y una suscripción de comodidad, pero nada de eso da ventaja competitiva.',
  },
  {
    q: '¿Puedo jugar desde el ordenador?',
    a: 'La app es para iOS y Android. Los juegos de PC como Valorant o League of Legends se vinculan y se compite en ellos, coordinando la partida desde el móvil.',
  },
];
---

<Base
  title="Descargar Ágora — pronto en iOS y Android"
  description="Ágora llega próximamente a App Store y Google Play. Reserva tu plaza en el pre-registro y entra el día del lanzamiento con el Pack Fundador y 7 días de Rise."
  schema={[
    appSchema(),
    breadcrumbSchema([
      { label: 'Inicio', href: '/' },
      { label: 'Descargar', href: '/descargar' },
    ]),
    faqSchema(faqs),
  ]}
>
  <section class="u-shell grid gap-14 pt-16 lg:grid-cols-[1.1fr_1fr] lg:items-center lg:pt-24">
    <div>
      <div
        class="inline-flex items-center gap-2 rounded-full border border-gold/30 bg-gold/10 px-3.5 py-1.5"
        data-reveal
      >
        <Icon name="clock" class="h-3.5 w-3.5 text-gold" />
        <span class="font-mono text-[0.62rem] uppercase tracking-[0.2em] text-gold">Próximamente</span>
      </div>

      <h1 class="mt-6 text-hero font-black uppercase" data-reveal data-reveal-delay="0.05">
        Descarga<br /><span class="text-neon">Ágora</span>
      </h1>
      <p class="mt-7 max-w-lg text-[1.05rem] text-muted" data-reveal data-reveal-delay="0.1">
        La app llega a iOS y Android de forma simultánea. Todavía no está publicada en las tiendas,
        así que la puerta de entrada es el pre-registro.
      </p>

      <!-- Botones de tienda -->
      <div class="mt-9 flex flex-wrap gap-3" data-reveal data-reveal-delay="0.15">
        {
          [
            { store: 'App Store', mark: 'appstore', sub: 'iOS', href: APP.ios },
            { store: 'Google Play', mark: 'googleplay', sub: 'Android', href: APP.android },
          ].map((s) =>
            APP.live && s.href ? (
              <a
                href={s.href}
                class="group inline-flex items-center gap-3 rounded-lg border border-neon bg-neon px-5 py-3.5 text-ink transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_0_32px_-6px_rgb(10_255_122/0.7)]"
              >
                <BrandMark mark={s.mark} class="h-7 w-7" title={s.store} />
                <span class="text-left">
                  <span class="block font-mono text-[0.55rem] uppercase tracking-[0.16em] opacity-70">
                    Descargar en
                  </span>
                  <span class="block font-display text-[0.86rem] font-black uppercase tracking-wide">
                    {s.store}
                  </span>
                </span>
              </a>
            ) : (
              <span
                class="group inline-flex cursor-default items-center gap-3 rounded-lg border border-line bg-surface/40 px-5 py-3.5 transition-colors duration-500 hover:border-gold/45"
                aria-disabled="true"
              >
                <BrandMark
                  mark={s.mark}
                  class="h-7 w-7 text-muted transition-colors duration-500 group-hover:text-gold"
                  title={s.store}
                />
                <span class="text-left">
                  <span class="block font-display text-[0.82rem] font-bold uppercase tracking-wide">
                    {s.store}
                  </span>
                  <span class="block font-mono text-[0.55rem] uppercase tracking-[0.16em] text-gold">
                    Muy pronto · {s.sub}
                  </span>
                </span>
              </span>
            ),
          )
        }
      </div>

      <a href="#pre-registro" class="u-btn u-btn--primary mt-6 hidden sm:inline-flex" data-reveal>
        Avísame el día del lanzamiento
        <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>

    <div class="relative mx-auto w-full max-w-[420px]" data-reveal data-reveal-delay="0.08">
      <Tilt class="w-full" rotate={9}>
        <div class="relative pb-4">
          <PhoneMockup
            src={bienvenida}
            alt="Pantalla de bienvenida de Ágora en el móvil"
            width={340}
            class="w-[68%]"
            offset={2}
            priority
          />
          <Image
            src={styxxEstandarte}
            alt="Styxx, la mascota de Ágora, sosteniendo el estandarte"
            width={440}
            densities={[1, 2]}
            class="pointer-events-none absolute bottom-0 right-0 z-10 w-[44%] max-w-[190px] drop-shadow-[0_22px_44px_rgb(0_0_0/0.75)]"
            data-atropos-offset="-6"
          />
        </div>
      </Tilt>
    </div>
  </section>

  <Preregistro id="pre-registro" compact />

  <!-- PASOS -->
  <Section eyebrow="Cómo funciona" title="De aquí al día del lanzamiento">
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
      {
        pasos.map((p) => (
          <article class="u-card p-6" data-reveal-item>
            <p class="font-mono text-[0.62rem] uppercase tracking-[0.24em] text-neon">{p.n}</p>
            <h3 class="mt-3 font-display text-[0.85rem] font-bold uppercase tracking-wide">{p.t}</h3>
            <p class="mt-2.5 text-[0.84rem] text-muted">{p.d}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-10 flex flex-col items-center gap-6 rounded-xl border border-line bg-surface/30 p-7 sm:flex-row" data-reveal>
      <div class="flex-1 text-center sm:text-left">
        <h3 class="font-display text-[0.95rem] font-black uppercase tracking-wide">
          Mientras tanto, sígueme la pista
        </h3>
        <p class="mt-2 text-sm text-muted">
          Publicamos avances, torneos y llamadas a clanes casi a diario.
        </p>
      </div>
      <ul class="flex gap-2.5">
        {
          SOCIAL.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener" class="u-btn u-btn--ghost !px-4 !py-2.5 !text-[0.66rem]">
                <BrandMark mark={s.name.toLowerCase()} class="h-3.5 w-3.5" />
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>
</Base>
