---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Premios from '../components/home/Premios.astro';
import Torneos from '../components/home/Torneos.astro';
import Comunidades from '../components/home/Comunidades.astro';
import Ranking from '../components/home/Ranking.astro';
import Progresion from '../components/home/Progresion.astro';
import Pantallas from '../components/home/Pantallas.astro';
import Preregistro from '../components/sections/Preregistro.astro';
import Dudas from '../components/home/Dudas.astro';
import { appSchema } from '../lib/schema.js';

// Orden pensado para que en 10 segundos se entienda qué es Ágora:
// qué es → premios reales → torneos → comunidades → ranking → progresión →
// cómo se ve → entrar → dudas.
---

<Base
  title="Ágora: app de torneos gaming con premios reales"
  description="Juega torneos oficiales con premios reales, reta a tus amigos, sube con tu clan en el ranking y crea torneos para tu comunidad. Para iOS y Android."
  rawTitle
  schema={[appSchema()]}
>
  <Hero />
  <Premios />
  <Torneos />
  <Comunidades />
  <Ranking />
  <Progresion />
  <Pantallas />
  <Preregistro />
  <Dudas />
</Base>
