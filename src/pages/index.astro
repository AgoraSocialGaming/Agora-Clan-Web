---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Section from '../components/ui/Section.astro';
import PhoneMockup from '../components/ui/PhoneMockup.astro';
import Tilt from '../components/ui/Tilt.astro';
import Rail from '../components/ui/Rail.astro';
import AppShowcase from '../components/sections/AppShowcase.astro';
import Preregistro from '../components/sections/Preregistro.astro';
import Icon from '../components/ui/Icon.astro';
import { appSchema } from '../lib/schema.js';
import { LANZAMIENTO } from '../data/juegos.js';

import misionesRacha from '../assets/app/agora-app-misiones-racha.png';
import perfilJugador from '../assets/app/agora-app-perfil-jugador.png';
import juegosVinculados from '../assets/app/agora-app-juegos-vinculados.png';

import perfilOro from '../assets/personalizacion/agora-perfil-rey-de-la-arena.png';
import perfilOlimpo from '../assets/personalizacion/agora-perfil-habitante-del-olimpo.png';
import perfilBerserker from '../assets/personalizacion/agora-perfil-berserker.png';
import perfilSenorGuerra from '../assets/personalizacion/agora-perfil-senor-de-la-guerra.png';

import cofreMadera from '../assets/cofres/cofre-madera.png';
import cofrePlata from '../assets/cofres/cofre-plata.png';
import cofreOro from '../assets/cofres/cofre-oro.png';

import marcoRise from '../assets/marcos/marco-rise.png';
import marcoPionero from '../assets/marcos/marco-pionero.png';
import marcoDragon from '../assets/marcos/marco-dragon.png';
import marcoSegador from '../assets/marcos/marco-segador.png';
import marcoHeraldo from '../assets/marcos/marco-heraldo.png';
import marcoElfico from '../assets/marcos/marco-elfico.png';

import brawl from '../assets/juegos/brawl-stars.jpg';
import clash from '../assets/juegos/clash-royale.png';
import valorant from '../assets/juegos/valorant.jpg';
import lol from '../assets/juegos/league-of-legends.jpg';

const covers: Record<string, ImageMetadata> = {
  'brawl-stars': brawl,
  'clash-royale': clash,
  valorant,
  'league-of-legends': lol,
};

const ciclo = [
  {
    n: '01',
    verb: 'Encontrar',
    title: 'Deja de jugar con desconocidos',
    body: 'Publica en Busco grupo filtrando por juego, idioma y horario, y monta el equipo que llevas meses buscando.',
  },
  {
    n: '02',
    verb: 'Competir',
    title: 'Monta un torneo en dos minutos',
    body: 'Duelos, emparejamiento rápido o brackets. Ágora coordina la partida, recoge los dos reportes y cierra el marcador solo.',
  },
  {
    n: '03',
    verb: 'Progresar',
    title: 'Que se note lo que has jugado',
    body: 'Nivel, XP, emblemas, títulos y marcos. Un historial que es tuyo y que atraviesa todos los juegos que vincules.',
  },
];

// Mismo perfil, pieles distintas: es lo que engancha de la personalización.
const perfiles = [
  { img: perfilOro, name: 'Rey de la Arena', sub: 'Marco legendario · fondo dorado' },
  { img: perfilOlimpo, name: 'Habitante del Olimpo', sub: 'Marco épico · fondo carmesí' },
  { img: perfilBerserker, name: 'Berserker', sub: 'Marco legendario · fondo glaciar' },
  { img: perfilSenorGuerra, name: 'Señor de la Guerra', sub: 'Marco raro · fondo violeta' },
];

const cofres = [
  { img: cofreMadera, name: 'Madera', tone: 'Común' },
  { img: cofrePlata, name: 'Plata', tone: 'Raro' },
  { img: cofreOro, name: 'Oro', tone: 'Épico' },
];

const marcos = [
  { img: marcoPionero, name: 'Pionero', tone: 'Irrepetible' },
  { img: marcoRise, name: 'Rise', tone: 'Suscripción' },
  { img: marcoDragon, name: 'Dragón', tone: 'Legendario' },
  { img: marcoSegador, name: 'Segador', tone: 'Épico' },
  { img: marcoHeraldo, name: 'Heraldo', tone: 'Legendario' },
  { img: marcoElfico, name: 'Bosque', tone: 'Raro' },
];

---

<Base
  title="Ágora — La arena digital para gamers"
  description="Encuentra con quién jugar, monta tu torneo con brackets y gana premios reales y recompensas in-app. Perfil RPG, clanes y ranking. Pronto en iOS y Android."
  rawTitle
  schema={[appSchema()]}
>
  <!-- ══════════ HERO ══════════ -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 opacity-40 [background-image:linear-gradient(rgb(10_255_122/0.05)_1px,transparent_1px),linear-gradient(90deg,rgb(10_255_122/0.05)_1px,transparent_1px)] [background-size:46px_46px] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,black,transparent)]"
      aria-hidden="true"
    >
    </div>

    <div class="u-shell relative grid gap-12 pb-[var(--spacing-section)] pt-16 lg:grid-cols-[1.1fr_1fr] lg:items-center lg:gap-10 lg:pt-24">
      <div>
        <p class="u-eyebrow" data-reveal>Próximamente · iOS y Android</p>

        <h1 class="mt-6 text-hero font-black uppercase" data-reveal data-reveal-delay="0.06">
          La arena<br />
          <span
            class="bg-[linear-gradient(110deg,#0AFF7A,#47F59A,#0AFF7A)] bg-[length:220%_100%] bg-clip-text text-transparent [animation:heroFlow_6s_linear_infinite]"
            >digital</span
          ><br />para gamers
        </h1>

        <p class="mt-7 max-w-lg text-[1.08rem] text-muted" data-reveal data-reveal-delay="0.12">
          Encuentra con quién jugar, compite cuando quieras y contra quien quieras, y mejora tu
          perfil con cada partida. Todo esto y más en una app.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-3" data-reveal data-reveal-delay="0.18">
          <a href="#pre-registro" class="u-btn u-btn--primary">
            Reservar mi plaza
            <Icon name="arrow" class="h-4 w-4" />
          </a>
          <a href="/torneos" class="u-btn u-btn--ghost">Ver los torneos</a>
        </div>

        <dl class="mt-12 grid max-w-lg grid-cols-3 gap-px overflow-hidden rounded-xl border border-line bg-line" data-reveal-group>
          {
            [
              { k: 'Encuentra', v: 'Amigos y equipo' },
              { k: 'Compite', v: 'En torneos' },
              { k: 'Mejora', v: 'Tu perfil' },
            ].map((s) => (
              <div class="bg-ink px-4 py-5" data-reveal-item>
                <dt class="font-mono text-[0.58rem] uppercase tracking-[0.18em] text-neon">{s.k}</dt>
                <dd class="mt-2 font-display text-[0.82rem] font-bold uppercase tracking-wide">{s.v}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- Abanico de tres pantallas: preview rápido sin ocupar media página -->
      <div class="relative mx-auto w-full max-w-[400px]" data-reveal data-reveal-delay="0.1">
        <Tilt class="w-full" rotate={9}>
          <div class="flex items-end justify-center">
            <PhoneMockup
              src={misionesRacha}
              alt="Misiones diarias y racha en la app de Ágora"
              width={210}
              class="w-[36%] -mr-[7%] -rotate-[7deg] translate-y-7"
              offset={-5}
              glow={false}
            />
            <PhoneMockup
              src={perfilJugador}
              alt="Perfil de jugador de Ágora con marco, título y emblemas"
              width={260}
              class="relative z-10 w-[42%]"
              offset={4}
              priority
            />
            <PhoneMockup
              src={juegosVinculados}
              alt="Juegos favoritos y estadísticas verificadas en la app de Ágora"
              width={210}
              class="w-[36%] -ml-[7%] rotate-[7deg] translate-y-7"
              offset={-5}
              glow={false}
            />
          </div>
        </Tilt>
      </div>
    </div>

    <!-- Cinta -->
    <div class="relative border-y border-line bg-surface/40 py-3.5" aria-hidden="true">
      <div class="flex gap-10 whitespace-nowrap [animation:marquee_28s_linear_infinite]">
        {
          Array.from({ length: 4 }).map(() => (
            <div class="flex shrink-0 gap-10 font-mono text-[0.66rem] uppercase tracking-[0.24em] text-muted">
              <span>Los juegos no cambiaron</span>
              <span class="text-neon">·</span>
              <span>Nosotros sí</span>
              <span class="text-neon">·</span>
              <span>Cero pay-to-win</span>
              <span class="text-neon">·</span>
              <span>Habilidad pura</span>
              <span class="text-neon">·</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ══════════ CICLO (carrusel) ══════════ -->
  <Section
    id="arena"
    eyebrow="Cómo funciona"
    title="Encontrar, competir, progresar"
    intro="Todo el ciclo dentro de la misma app. Sin hojas de cálculo, sin bracket en otra web, sin alguien haciendo de árbitro a mano."
  >
    <Rail label="Cómo funciona Ágora" class="mt-10">
      {
        ciclo.map((step) => (
          <li class="u-card group w-[268px] shrink-0 snap-start p-6 sm:w-[300px]">
            <div class="flex items-baseline gap-3">
              <span class="font-display text-2xl font-black text-neon/30 transition-colors duration-500 group-hover:text-neon/70">
                {step.n}
              </span>
              <p class="font-mono text-[0.62rem] uppercase tracking-[0.24em] text-neon">{step.verb}</p>
            </div>
            <h3 class="mt-4 font-display text-[0.98rem] font-black uppercase leading-tight">
              {step.title}
            </h3>
            <p class="mt-3 text-[0.88rem] text-muted">{step.body}</p>
          </li>
        ))
      }
    </Rail>

    <div class="mt-6 flex flex-wrap gap-3" data-reveal>
      <a href="/torneos" class="u-btn u-btn--primary">
        Cómo funcionan los torneos
        <Icon name="arrow" class="h-4 w-4" />
      </a>
      <a href="/torneos#comunidad" class="u-btn u-btn--ghost">Tengo una comunidad</a>
    </div>
  </Section>

  <!-- ══════════ EXPLORADOR DE PANTALLAS ══════════ -->
  <AppShowcase />

  <!-- ══════════ PERFIL Y RECOMPENSAS ══════════ -->
  <Section
    eyebrow="Tu vitrina"
    title="Un perfil que no se parece a ningún otro"
    intro="Marco, título, emblemas y fondo. La combinación hace que dos perfiles nunca sean iguales, y nada de eso toca el equilibrio: es apariencia, no ventaja."
  >
    <Rail label="Ejemplos de perfil personalizado" class="mt-10">
      {
        perfiles.map((p) => (
          <li class="group w-[212px] shrink-0 snap-start sm:w-[240px]">
            <div class="overflow-hidden rounded-xl border border-line transition-all duration-500 group-hover:-translate-y-1.5 group-hover:border-neon/50">
              <Image
                src={p.img}
                alt={`Perfil de Ágora personalizado con el título ${p.name}`}
                width={480}
                densities={[1, 2]}
                class="w-full"
              />
            </div>
            <p class="mt-2.5 font-display text-[0.7rem] font-bold uppercase tracking-wide">{p.name}</p>
            <p class="font-mono text-[0.53rem] uppercase tracking-[0.14em] text-muted">{p.sub}</p>
          </li>
        ))
      }
    </Rail>

    <!-- Cofres: pequeños y al grano -->
    <div class="mt-12" data-reveal>
      <h3 class="font-display text-[0.92rem] font-black uppercase tracking-wide">
        Los cofres se ganan, no se compran
      </h3>
      <p class="mt-2 max-w-2xl text-[0.88rem] text-muted">
        Caen jugando, con la racha diaria, viendo un anuncio o como premio de torneo. Dentro hay
        marcos, títulos y cosméticos. Nunca están a la venta.
      </p>
      <ul class="mt-5 grid grid-cols-3 gap-3 sm:max-w-md">
        {
          cofres.map((c) => (
            <li class="flex items-center gap-3 rounded-xl border border-line bg-surface/50 px-3 py-2.5 transition-colors duration-500 hover:border-neon/45">
              <Image
                src={c.img}
                alt={`Cofre de ${c.name} de Ágora`}
                width={120}
                densities={[1, 2]}
                class="h-9 w-9 shrink-0 object-contain"
              />
              <span class="min-w-0">
                <span class="block font-display text-[0.68rem] font-bold uppercase tracking-wide">{c.name}</span>
                <span class="block font-mono text-[0.5rem] uppercase tracking-[0.14em] text-neon">{c.tone}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Recompensas en carrusel -->
    <div class="mt-10">
      <p class="u-eyebrow !text-muted" data-reveal>Lo que sale de los cofres</p>
      <Rail label="Marcos de avatar y recompensas" class="mt-4">
        {
          marcos.map((m) => (
            <li class="group w-[92px] shrink-0 snap-start">
              <div class="grid aspect-square place-items-center rounded-xl border border-line bg-surface/60 p-2 transition-all duration-500 group-hover:-translate-y-1.5 group-hover:border-neon/50">
                <Image
                  src={m.img}
                  alt={`Marco de avatar ${m.name}`}
                  width={170}
                  densities={[1, 2]}
                  class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-110"
                />
              </div>
              <p class="mt-2 text-center font-display text-[0.6rem] font-bold uppercase tracking-wide">
                {m.name}
              </p>
              <p class="text-center font-mono text-[0.48rem] uppercase tracking-[0.14em] text-muted">
                {m.tone}
              </p>
            </li>
          ))
        }
      </Rail>
    </div>
  </Section>

  <!-- ══════════ CLANES Y COMUNIDAD ══════════ -->
  <Section eyebrow="Clanes" title="Trae a los tuyos" intro="Crea tu clan con escudo por capas, reparte roles y enfrenta a tu gente contra otros clanes. Ganar sube al clan en la clasificación global.">
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
      {
        [
          { i: 'shield', t: 'Escudo por capas' },
          { i: 'users', t: 'Roles y miembros' },
          { i: 'star', t: 'Elo y leaderboard' },
          { i: 'bracket', t: 'Torneos de clan' },
        ].map((c) => (
          <div class="flex items-center gap-3 rounded-lg border border-line px-4 py-3.5" data-reveal-item>
            <Icon name={c.i} class="h-4 w-4 shrink-0 text-neon" />
            <span class="text-[0.86rem]">{c.t}</span>
          </div>
        ))
      }
    </div>

    <div
      class="mt-8 flex flex-col gap-5 rounded-xl border border-neon/25 bg-neon/[0.04] p-7 sm:flex-row sm:items-center sm:justify-between"
      data-reveal
    >
      <p class="max-w-xl text-[0.95rem] text-muted">
        <strong class="text-bone">¿Ya tienes comunidad?</strong> Llega con tu clan, tu servidor o tu
        audiencia y te damos un clan gratuito con un límite de miembros mucho más amplio, más
        recompensas para todos los que entren contigo.
      </p>
      <a href="/torneos#comunidad" class="u-btn u-btn--primary shrink-0">
        Traigo mi comunidad
        <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>
  </Section>

  <!-- ══════════ JUEGOS ══════════ -->
  <Section
    eyebrow="Catálogo"
    title="Juegos en el lanzamiento"
    intro="Cuatro títulos de comunidad enorme, dos de móvil y dos de PC. El catálogo rota cada temporada y puedes crear tus torneos en cualquier juego que esté en la wiki de Ágora."
  >
    <div class="mt-10 grid grid-cols-2 gap-4 lg:grid-cols-4" data-reveal-group>
      {
        LANZAMIENTO.map((g) => (
          <a href="/juegos" class="group block" data-reveal-item>
            <div class="relative overflow-hidden rounded-xl border border-line transition-all duration-500 group-hover:-translate-y-1.5 group-hover:border-neon/50">
              <Image
                src={covers[g.slug]}
                alt={`${g.name}, uno de los juegos disponibles en Ágora en el lanzamiento`}
                width={360}
                densities={[1, 2]}
                class="aspect-square w-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <div
                class="absolute inset-0 bg-gradient-to-t from-ink via-ink/25 to-transparent opacity-80 transition-opacity duration-500 group-hover:opacity-95"
                aria-hidden="true"
              />
              <div class="absolute inset-x-0 bottom-0 p-3.5">
                <p class="font-display text-[0.78rem] font-black uppercase leading-tight">{g.name}</p>
                <p class="mt-1 font-mono text-[0.55rem] uppercase tracking-[0.16em]" style={`color:${g.color}`}>
                  {g.platform}
                </p>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <div class="mt-8" data-reveal>
      <a href="/juegos" class="u-btn u-btn--ghost">
        Ver el catálogo completo
        <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>
  </Section>

  <!-- ══════════ PRE-REGISTRO ══════════ -->
  <Preregistro />

</Base>

<style>
  @keyframes heroFlow {
    to {
      background-position: 220% 0;
    }
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
</style>
