---
// La página de juegos se ha integrado en /torneos#juegos. Se mantiene esta
// ruta para no romper enlaces antiguos: redirige y no se indexa.
import { url } from '../lib/url.js';
import { SITE } from '../data/site.js';
const destino = url('/torneos#oficiales');
const canonical = new URL('/torneos', Astro.site ?? SITE.url).toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Juegos de Ágora</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0; url=${destino}`} />
    <script is:inline define:vars={{ destino }}>location.replace(destino);</script>
  </head>
  <body style="background:#101016;color:#fff;font-family:sans-serif">
    <p>Los juegos de Ágora están ahora en <a href={destino} style="color:#0aff7a">la página de torneos</a>.</p>
  </body>
</html>
