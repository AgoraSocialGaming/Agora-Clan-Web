---
import { url } from '../lib/url.js';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Heading from '../components/ui/Heading.astro';
import Preregistro from '../components/sections/Preregistro.astro';
import Icon from '../components/ui/Icon.astro';
import { breadcrumbSchema, faqSchema, gameListSchema } from '../lib/schema.js';
import { FAQ } from '../data/faq.js';
import { LANZAMIENTO } from '../data/juegos.js';

import styxxGuerrero from '../assets/mascotas/styxx-guerrero.png';
import gorgoTablero from '../assets/mascotas/gorgo-tablero.png';
import brawl from '../assets/juegos/brawl-stars.jpg';
import clash from '../assets/juegos/clash-royale.png';
import valorant from '../assets/juegos/valorant.jpg';
import lol from '../assets/juegos/league-of-legends.jpg';

const covers: Record<string, ImageMetadata> = {
  'brawl-stars': brawl,
  'clash-royale': clash,
  valorant,
  'league-of-legends': lol,
};

const crear = [
  { n: '1', t: 'Elige juego y formato', d: 'Muchos más juegos que los oficiales. Individual, por equipos o clan contra clan, con las plazas que quieras.' },
  { n: '2', t: 'Pon tus reglas', d: 'Reglas de la partida, fechas y entrada. El torneo lleva tu nombre.' },
  { n: '3', t: 'Invita con un enlace', d: 'Lo compartes en tu Discord, tu canal o tu clan y la gente se apunta desde la app.' },
  { n: '4', t: 'El bracket avanza solo', d: 'Ágora empareja cada ronda, avisa a los jugadores y actualiza el cuadro con cada resultado.' },
];

const batallas = [
  {
    icon: 'users',
    t: 'Con amigos',
    d: 'Retas a alguien de tu lista y jugáis cuando os venga bien. De 1v1 a 5v5, amistosa o con apuesta.',
    rank: 'Ranking individual',
    clan: false,
  },
  {
    icon: 'bolt',
    t: 'Aleatorias',
    d: 'Matchmaking contra un rival de tu nivel que esté buscando partida en ese momento.',
    rank: 'Ranking individual',
    clan: false,
  },
  {
    icon: 'shield',
    t: 'De clan',
    d: 'Tu clan reta a otro. Cada victoria sube a tu clan y, al cerrar la temporada, hay recompensa para cada miembro.',
    rank: 'Ranking de clanes',
    clan: true,
  },
];

const partida = [
  { t: 'Añade tu ID', d: 'Para competir en un juego, tu ID tiene que estar en tu perfil. Si el juego tiene API oficial, Ágora además verifica la cuenta y tus estadísticas.' },
  { t: 'Se juega', d: 'Cada jugador ve el ID de su rival para montar la partida dentro del juego.' },
  { t: 'Doble reporte', d: 'Al terminar, cada parte reporta el resultado y puede adjuntar capturas.' },
  { t: 'Cierre o disputa', d: 'Si los reportes coinciden, se cierra al instante. Si no, un administrador revisa las pruebas y decide.' },
];

const faqs = FAQ.filter((g) => g.id === 'torneos' || g.id === 'premios').flatMap((g) => g.items).slice(0, 8);
---

<Base
  title="Torneos oficiales con premios y torneos para tu comunidad"
  description="Juega torneos oficiales de Ágora con premios reales o crea torneos personalizados para tu comunidad o clan. Batallas, ranking de temporada y brackets automáticos."
  schema={[
    breadcrumbSchema([
      { label: 'Inicio', href: '/' },
      { label: 'Torneos', href: '/torneos' },
    ]),
    gameListSchema('Juegos de los torneos oficiales de Ágora', LANZAMIENTO),
    faqSchema(faqs),
  ]}
>
  <!-- HERO -->
  <section class="u-shell relative grid gap-12 pb-6 pt-12 sm:pt-16 lg:grid-cols-[1.05fr_1fr] lg:items-center lg:pt-20">
    <div>
      <Heading
        as="h1"
        tag="Torneos"
        title='Juega los oficiales. <span class="t-neon">Monta los tuyos.</span>'
        intro="Los torneos oficiales los organiza Ágora y reparten premios reales. Los personalizados los crea cualquier jugador o comunidad, con sus propias reglas. Y fuera de los torneos, puedes retar a tus amigos, buscar rival o enfrentarte a otros clanes."
      />
      <div class="mt-8 flex flex-wrap gap-3" data-reveal data-reveal-delay="0.16">
        <a href="#oficiales" title="Torneos oficiales de Ágora con premios reales" class="u-btn u-btn--gold">
          Torneos oficiales
          <Icon name="trophy" class="h-4 w-4" />
        </a>
        <a href="#personalizados" title="Cómo crear un torneo personalizado en Ágora" class="u-btn u-btn--ghost">Crear mi torneo</a>
      </div>
    </div>

    <!-- Cuadro de torneo: se dibuja solo; la final lleva premio -->
    <div class="relative min-w-0" data-reveal data-reveal-delay="0.08">
      <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(closest-side,rgb(10_255_122/0.12),transparent)]" aria-hidden="true"></div>
      <svg viewBox="0 0 440 250" class="w-full" role="img" aria-label="Cuadro de torneo por eliminatorias con premio en la final">
        <g fill="none" stroke="rgb(10 255 122 / 0.5)" stroke-width="1.2" stroke-linecap="round" data-draw>
          <path d="M118 42h34M118 100h34M152 42V100M152 71h34" />
          <path d="M118 166h34M118 208h34M152 166V208M152 187h34" />
          <path d="M286 71h16M286 187h16M302 71V187M302 129h14" />
        </g>
        {
          [
            { y: 28, label: 'Jugador 1', on: true },
            { y: 86, label: 'Jugador 2', on: false },
            { y: 152, label: 'Jugador 3', on: true },
            { y: 194, label: 'Jugador 4', on: false },
          ].map((s) => (
            <g>
              <rect x="18" y={s.y} width="100" height="28" rx="6" fill="rgb(23 23 32 / 0.9)" stroke={s.on ? 'rgb(10 255 122 / 0.65)' : 'rgb(46 46 58)'} />
              <text x="32" y={s.y + 18} fill={s.on ? '#0AFF7A' : '#9AA0AD'} font-family="JetBrains Mono, monospace" font-size="9" letter-spacing="1.4">{s.label.toUpperCase()}</text>
            </g>
          ))
        }
        {
          [57, 173].map((y) => (
            <g>
              <rect x="186" y={y} width="100" height="28" rx="6" fill="rgb(23 23 32 / 0.9)" stroke="rgb(10 255 122 / 0.65)" />
              <text x="200" y={y + 18} fill="#0AFF7A" font-family="JetBrains Mono, monospace" font-size="9" letter-spacing="1.4">SEMIFINAL</text>
            </g>
          ))
        }
        <rect x="316" y="111" width="112" height="36" rx="8" fill="rgb(245 196 81 / 0.12)" stroke="#F5C451" />
        <text x="330" y="127" fill="#F5C451" font-family="JetBrains Mono, monospace" font-size="9" letter-spacing="1.4">FINAL</text>
        <text x="330" y="140" fill="#F5C451" font-family="JetBrains Mono, monospace" font-size="7.5" letter-spacing="1.2" opacity="0.8">PREMIO REAL</text>
      </svg>
    </div>
  </section>

  <!-- OFICIALES -->
  <section id="oficiales" class="u-shell scroll-mt-24 py-[var(--spacing-section)]">
    <div class="u-panel overflow-hidden" style="--edge: rgb(245 196 81 / 0.6)">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(55%_80%_at_90%_50%,rgb(245_196_81/0.13),transparent_70%)]" aria-hidden="true"></div>
      <div class="relative grid items-center gap-10 p-6 sm:p-10 lg:grid-cols-[1.2fr_0.8fr] lg:p-14">
        <div>
          <Heading
            tag="Torneos oficiales"
            tone="var(--color-gold)"
            title='Organizados por Ágora, <span class="t-gold">con premios reales</span>'
            intro="Son los torneos con los premios más grandes: premios reales para el podio, anunciados antes de empezar. Individuales o por clanes, con el arbitraje del equipo de Ágora, y cuentan para tu ranking de temporada."
          />
          <div id="juegos" class="mt-7 scroll-mt-28" data-reveal>
            <p class="font-mono text-[0.58rem] uppercase tracking-[0.18em] text-muted">Se juegan en</p>
            <ul class="mt-3 flex flex-wrap gap-2">
              {
                LANZAMIENTO.map((g) => (
                  <li class="flex items-center gap-2 rounded-full border border-line bg-ink/70 py-1 pl-1 pr-3">
                    <Image src={covers[g.slug]} alt="" width={48} densities={[1, 2]} class="h-6 w-6 rounded-full object-cover" />
                    <span class="text-[0.78rem]">{g.name}</span>
                  </li>
                ))
              }
            </ul>
            <p class="mt-3 max-w-lg text-[0.8rem] leading-relaxed text-muted">
              Los juegos con API oficial, para que cada cuenta y cada resultado se puedan verificar. Los
              torneos personalizados admiten muchos más.
            </p>
          </div>
          <ul class="mt-8 grid gap-3 sm:grid-cols-3" data-reveal-group>
            {
              [
                { i: 'trophy', t: 'Premios reales', d: 'Para el podio de cada torneo.' },
                { i: 'gift', t: 'Tarjetas regalo', d: 'Cada torneo suma, aunque no ganes.' },
                { i: 'crown', t: 'Ranking', d: 'Cuenta para tu temporada.' },
              ].map((p) => (
                <li class="rounded-2xl border border-gold/25 bg-gold/[0.05] p-4" data-reveal-item>
                  <Icon name={p.i} class="h-5 w-5 text-gold" />
                  <p class="mt-3 font-display text-[0.78rem] font-bold uppercase tracking-wide">{p.t}</p>
                  <p class="mt-1 text-[0.82rem] text-muted">{p.d}</p>
                </li>
              ))
            }
          </ul>
          <p class="mt-6 text-[0.8rem] text-muted" data-reveal>
            Los torneos con premio físico enviado a casa son solo para mayores de 18 años.
          </p>
        </div>
        <Image
          src={styxxGuerrero}
          alt="Styxx, mascota de Ágora, preparado para competir con espada y escudo"
          width={460}
          densities={[1, 2]}
          class="u-mascot mx-auto w-full max-w-[340px]"
          data-pop
        />
      </div>
    </div>
  </section>

  <!-- PERSONALIZADOS -->
  <section id="personalizados" class="u-shell scroll-mt-24 py-[var(--spacing-section)]">
    <div class="grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div>
        <Heading
          tag="Torneos personalizados"
          tone="var(--color-gorgo)"
          title='Tu torneo, <span style="color:var(--color-gorgo)">en dos minutos</span>'
          intro="Para tu clan, tu servidor de Discord o tu comunidad. Lo creas desde el móvil, en muchos más juegos que los oficiales, y Ágora se encarga del resto."
        />
        <Image
          src={gorgoTablero}
          alt="Gorgo, mascota de Ágora, moviendo las piezas en un tablero de estrategia"
          width={560}
          densities={[1, 2]}
          class="u-mascot mt-8 w-full max-w-[420px]"
          data-pop
        />
      </div>

      <ol class="relative space-y-3" data-reveal-group>
        <span class="absolute bottom-6 left-[1.55rem] top-6 w-px bg-gradient-to-b from-gorgo/60 via-gorgo/25 to-transparent" aria-hidden="true"></span>
        {
          crear.map((c) => (
            <li class="relative flex gap-4 rounded-2xl border border-line bg-ink/70 p-4 sm:p-5" data-reveal-item>
              <span class="relative z-10 grid h-8 w-8 shrink-0 place-items-center rounded-full border border-gorgo/50 bg-ink font-display text-[0.8rem] font-black text-gorgo">
                {c.n}
              </span>
              <span>
                <span class="block font-display text-[0.86rem] font-bold uppercase tracking-wide">{c.t}</span>
                <span class="mt-1 block text-[0.88rem] leading-relaxed text-muted">{c.d}</span>
              </span>
            </li>
          ))
        }
        <li class="flex flex-wrap gap-2 pl-1 pt-2" data-reveal-item>
          {
            ['Individual', 'Por equipos', 'Clan contra clan', 'Entrada a tu elección', 'Roles de organizador', 'Resolución de disputas'].map((t) => (
              <span class="rounded-lg border border-line px-2.5 py-1 font-mono text-[0.6rem] uppercase tracking-[0.12em] text-muted">{t}</span>
            ))
          }
        </li>
      </ol>
    </div>

    <div class="mt-10 flex flex-col gap-5 rounded-2xl border border-gorgo/30 bg-gorgo/[0.05] p-5 sm:flex-row sm:items-center sm:justify-between sm:p-7" data-reveal>
      <p class="max-w-xl text-[0.94rem] text-muted">
        <strong class="text-bone">¿Tienes comunidad?</strong> Ampliamos tu clan por encima de las 25
        plazas y, si la traes desde fuera, entra en el programa de creadores.
      </p>
      <a href={url('/comunidad')} title="Trae tu comunidad a Ágora: programa para creadores" class="u-btn shrink-0 !bg-gorgo !text-ink">
        Traer mi comunidad
        <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>
  </section>

  <!-- BATALLAS -->
  <section id="batallas" class="u-shell scroll-mt-24 py-[var(--spacing-section)]">
    <Heading
      tag="Batallas"
      tone="var(--color-ladon)"
      title="Batallas: partidas fuera de torneo"
      intro="No hace falta esperar a un torneo para competir. Las batallas también cuentan para la temporada: las de clan suben a tu clan; las demás, a ti."
    />
    <div class="mt-10 grid gap-3 md:grid-cols-3" data-reveal-group>
      {
        batallas.map((b) => (
          <article class="u-card p-6" data-reveal-item>
            <span
              class:list={[
                'grid h-11 w-11 place-items-center rounded-xl',
                b.clan ? 'bg-ladon/15 text-ladon' : 'bg-neon/10 text-neon',
              ]}
            >
              <Icon name={b.icon} class="h-5 w-5" />
            </span>
            <h3 class="mt-5 font-display text-[0.95rem] font-black uppercase">Batallas {b.t.toLowerCase()}</h3>
            <p class="mt-2 text-[0.88rem] leading-relaxed text-muted">{b.d}</p>
            <p class:list={['mt-4 font-mono text-[0.58rem] uppercase tracking-[0.16em]', b.clan ? 'text-ladon' : 'text-neon/80']}>
              Suma al {b.rank.toLowerCase()}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- CÓMO SE RESUELVE UNA PARTIDA -->
  <section id="partida" class="u-shell scroll-mt-24 py-[var(--spacing-section)]">
    <Heading tag="Juego limpio" title="Cómo se resuelve una partida" />
    <ol class="mt-10 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
      {
        partida.map((p, i) => (
          <li class="bg-ink p-5 sm:p-6" data-reveal-item>
            <p class="font-mono text-[0.62rem] text-neon">0{i + 1}</p>
            <h3 class="mt-3 font-display text-[0.85rem] font-bold uppercase tracking-wide">{p.t}</h3>
            <p class="mt-2 text-[0.86rem] leading-relaxed text-muted">{p.d}</p>
          </li>
        ))
      }
    </ol>
  </section>


  <!-- DUDAS -->
  <section class="u-shell py-[var(--spacing-section)]">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div>
        <Heading tag="Dudas" title="Sobre torneos y premios" />
        <a href={url('/faq')} class="u-btn u-btn--ghost mt-8" title="Preguntas frecuentes sobre Ágora" data-reveal>
          Todas las preguntas
          <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>
      <div class="divide-y divide-line border-y border-line" data-reveal>
        {
          faqs.map((f) => (
            <details class="group">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden">
                <h3 class="font-body text-[0.98rem] font-semibold tracking-normal transition-colors group-open:text-neon">{f.q}</h3>
                <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full border border-line text-muted transition-all duration-300 group-open:rotate-45 group-open:border-neon group-open:text-neon">
                  <Icon name="plus" class="h-3.5 w-3.5" />
                </span>
              </summary>
              <p class="max-w-2xl pb-6 text-[0.92rem] leading-relaxed text-muted">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <Preregistro compact />
</Base>
